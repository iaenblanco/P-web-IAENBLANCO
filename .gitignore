# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# salidas de las herramientas de verificacion
# .tmp/ son los perfiles de Chrome que deja herramientas/verificar.mjs:
# ~100 MB por pasada, y no estaban ignorados.
/.tmp/

# reports/ son las mediciones de Lighthouse. Los JSON por pasada pesan ~20 MB
# por medicion y no se citan nunca. Entra al repositorio solo lo que despues
# se lee: el resumen, las crudas y el LEEME. Son ~30 KB en total y son la
# linea base contra la que compara la fase siguiente.
# El !/reports/**/ es obligatorio: sin re-incluir los directorios, git no
# entra a mirarlos y las excepciones de abajo nunca llegan a aplicarse.
/reports/**
!/reports/**/
!/reports/**/resumen-*.json
!/reports/**/crudas-*.json
!/reports/**/LEEME.md
# typescript
*.tsbuildinfo
next-env.d.ts
